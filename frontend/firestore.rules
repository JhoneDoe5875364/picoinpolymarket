// deny direct client writes to ledger/positions/resolution
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == uid;
    }
    match /markets/{id} {
      allow read: if true;
      allow write: if false; // only via Functions (admin)
    }
    match /positions/{id} {
      allow read: if isSignedIn();
      allow write: if false; // Functions only
    }
    match /ledger/{id} {
      allow read: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow write: if false; // Functions only
    }
    match /payment_requests/{id} {
      allow read, write: if false; // Functions only
    }
    match /auth_nonces/{id} {
      allow read, write: if false; // Functions only
    }
    match /admin_audit/{id} {
      allow read, write: if false; // Functions only
    }
  }
}
